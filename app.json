{
  "expo": {
    "name": "Fabwms",
    "slug": "Fabwms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/My/icon.png",
    "scheme": "fabwms",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/My/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.abubaker_siddiq.Fabwms"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/My/id.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-camera",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "574085b9-1bb6-48c0-b33c-393a27cb160a"
      }
    },
    "owner": "abubaker_siddiq"
  }
}
